# LLM (Groq — free tier at https://console.groq.com)
GROQ_API_KEY=gsk_your-key-here
GROQ_MODEL=openai/gpt-oss-120b

# Tools
TAVILY_API_KEY=tvly-your-key-here

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/multi_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=multi_agent

# Redis
REDIS_URL=redis://localhost:6379/0

# Budget Limits
MAX_STEPS=50
MAX_TOKENS=100000
MAX_COST_USD=5.00

# Server
API_HOST=0.0.0.0
API_PORT=8000

# Google OAuth (create credentials at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=change-this-to-a-random-secret
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
